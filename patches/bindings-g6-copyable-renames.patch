 #include <iostream>
 #include <set>
 
+// GucciBot patch (patches/bindings-g6-copyable-renames.patch): an old name
+// kept for a renamed member is a union with the new one. For a class type
+// with its own copy constructor (cocos2d::CCPoint, std::string) that union
+// can't be copied, so neither can GJGameState, which GucciBot copies for
+// practice checkpoints and the path preview. Old names stay only for plain
+// scalars and pointers, whose unions copy fine; the layout is the same.
+// The bindings' own inline code is moved to the new names where it used a
+// dropped old one (GJBaseGameLayer::modifyObjectPhysics).
+static bool gbAliasCopies(std::string const& t) {
+    if (!t.empty() && t.back() == '*') return true;
+    static std::set<std::string> const k = {
+        "bool", "char", "short", "int", "long", "float", "double",
+        "unsigned", "unsigned int", "unsigned char", "unsigned short", "unsigned long",
+        "long long", "unsigned long long", "int8_t", "int16_t", "int32_t", "int64_t",
+        "uint8_t", "uint16_t", "uint32_t", "uint64_t", "size_t", "intptr_t", "uintptr_t",
+    };
+    return k.count(t) > 0;
+}
